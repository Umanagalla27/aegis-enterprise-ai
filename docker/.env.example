# Copy to docker/.env (git-ignored), replace every value, then: chmod 600 .env
# Image built by CI: a commit SHA (e.g. a6fda7c) or a release version (e.g. 1.0.0)
IMAGE_TAG=1.0.0
DOMAIN=aegis.example.com
AEGIS_CORS_ORIGINS=https://aegis.example.com
# Generate secrets with: openssl rand -hex 32
AEGIS_API_KEY=change-me
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
